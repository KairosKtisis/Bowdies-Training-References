// ─────────────────────────────────────────────────────────────────────────
// PICKER — deterministic by pair key
//
// Returns { verb, why } for the given (drinkClass, foodCategory, pairKey),
// or null if the cell isn\'t seeded yet (generator should fall back to current
// "overpowers" template).
// ─────────────────────────────────────────────────────────────────────────

function pickAvoidReasoning(drinkClass, foodCategory, pairKey) {
  const cell = (AVOID_REASONING_POOL[drinkClass] || {})[foodCategory];
  if (!Array.isArray(cell) || cell.length === 0) return null;
  // Deterministic md5-based pick — same pair always picks the same entry,
  // distribution across pair-space is even.
  const hash = crypto.createHash('md5').update(pairKey).digest('hex');
  const idx = parseInt(hash.slice(0, 8), 16) % cell.length;
  return cell[idx];
}

// ─────────────────────────────────────────────────────────────────────────
// COVERAGE REPORT — emits a quick summary when this module is run directly.
// ─────────────────────────────────────────────────────────────────────────

function coverageReport() {
  const out = { classes: 0, cells: 0, entries: 0, byClass: {} };
  for (const [dc, cells] of Object.entries(AVOID_REASONING_POOL)) {
    const filledCells = Object.entries(cells).filter(([, arr]) => Array.isArray(arr) && arr.length > 0);
    if (filledCells.length === 0) continue;
    out.classes++;
    out.cells += filledCells.length;
    const cellInfo = {};
    for (const [fc, arr] of filledCells) {
      cellInfo[fc] = arr.length;
      out.entries += arr.length;
    }
    out.byClass[dc] = cellInfo;
  }
  return out;
}

if (require.main === module) {
  const rpt = coverageReport();
  console.log('=== AVOID_REASONING_POOL coverage ===');
  console.log(`Classes seeded: ${rpt.classes}`);
  console.log(`Cells seeded:   ${rpt.cells}`);
  console.log(`Total entries:  ${rpt.entries}`);
  console.log('');
  for (const [dc, cells] of Object.entries(rpt.byClass)) {
    console.log(`  ${dc}:`);
    for (const [fc, n] of Object.entries(cells)) {
      console.log(`    ${fc.padEnd(12)}  ${n} entries`);
    }
  }
}

module.exports = { AVOID_REASONING_POOL, pickAvoidReasoning, coverageReport };
