// engine/avoid_reasoning_pool.js
//
// PHASE 2 (GAMEPLAN_v1) — per-pair reasoning for DxF AVOID notes.
//
// The problem this solves: the current AVOID template is
//
//   "{Drink}'s {character} overpowers the {food}'s {edge} -- the plate
//    deserves {alts}, not a {dcLabel}. Avoid; {closer}. {save-clause}."
//
// Every avoid says "overpowers" and gives no per-pair reasoning. A server
// asked "why?" by a guest has nothing specific to say. Phase 2 fixes this
// by substituting a {verb, why} pair from this pool, producing:
//
//   "{Drink}'s {character} {VERB} the {food}'s {edge} — {WHY}. The plate
//    deserves {alts}, not a {dcLabel}. Avoid; {closer}. {save-clause}."
//
// Example before/after for Larceny × Trout:
//
//   BEFORE: Larceny Small Batch's spice-and-caramel bourbon depth overpowers
//           the trout's delicate flesh -- the plate deserves Joseph Mellot
//           Sancerre, Jean-Pierre Grossot Chablis, or Domaine de Berthiers
//           Pouilly-Fumé, not a bourbon. Avoid; reach for any of those instead.
//           Larceny Small Batch belongs on the steak course.
//
//   AFTER:  Larceny Small Batch's spice-and-caramel bourbon depth smothers
//           the trout's delicate flesh — the brown-spirit weight pulls focus
//           off the delicate fish protein. The plate deserves Joseph Mellot
//           Sancerre, Jean-Pierre Grossot Chablis, or Domaine de Berthiers
//           Pouilly-Fumé, not a bourbon. Avoid; reach for any of those
//           instead. Larceny Small Batch belongs on the steak course.
//
// The server can now say "the bourbon weight pulls focus off the delicate
// fish — try a Sancerre instead" — concrete, defensible, sommelier-grade.
//
// ─────────────────────────────────────────────────────────────────────────
//
// Structure:
//   AVOID_REASONING_POOL[drinkClass][foodCategory] = [
//     { verb: 'smothers',
//       why: 'the brown-spirit weight pulls focus off the delicate fish protein',
//       source: 'curated',       // 'curated' = mined from FxF AVOIDs voice template
//                                 // 'handwritten' = written for this pool
//       tags: ['weight', 'delicate'],   // optional clash-type tags for future analysis
//     },
//     ...
//   ]
//
// Picker (in drink_x_food_generator.js, wired in Session 3):
//   pickAvoidReasoning(drinkClass, foodCategory, pairKey) — deterministic
//   hash by pairKey ensures stable, distributed selection across the cell.
//
// ─────────────────────────────────────────────────────────────────────────
//
// SESSION 2 STATUS (2026-05-30):
//   ✅ BOURBON_BOLD — all 6 cells seeded with 4-5 entries each
//   ✅ ELEGANT_RED  — all 6 cells seeded with 4-5 entries each
//   ⏳ Remaining classes — scaffolded with TBD markers, to be filled in
//      Sessions 2b / 2c. Generator will fall back to current "overpowers"
//      template for unseeded cells until then.
//
// Total: 56 entries across 12 cells in this seed.
// Coverage: ~55.7% of all DxF AVOID notes (8,292 of 14,874).

'use strict';

const crypto = require('crypto');

